@using Sandbox
@using Sandbox.UI

@inherits PanelComponent
@namespace Sandbox

@{
	var player = Player.FindLocalPlayer();
	var data = player?.PlayerData;
	var game = ZombieSurvivalGame.Current;

	if ( !ZombieSurvivalGame.Enabled || game is null || !player.IsValid() || player.WantsHideHud || !data.IsValid() )
		return;
}

<div class="zs-hud">
	<div class="primary">
		<div class="phase">@PhaseText</div>
		<div class="timer">@TimerText</div>
	</div>

	<div class="secondary">
		<div class="role @RoleClass">@RoleText</div>
		<div class="objective">@ObjectiveText</div>
	</div>

	<div class="counts">
		<label>@game.HumanCount humans</label>
		<label>@game.ZombieCount zombies</label>
	</div>

	@if ( data.ZombieSurvivalRole == ZombieSurvivalRole.Human )
	{
		<div class="budget">
			<label>@data.ZombieSurvivalCoins coins</label>

			@if ( game.Phase == ZombieSurvivalPhase.Build )
			{
				<label>@data.ZombieSurvivalBuildPoints build points</label>
				<label>@ZombieSurvivalGame.GetPropSpawnCost() per prop</label>
			}
		</div>
	}
</div>

@code
{
	Player Player => Player.FindLocalPlayer();
	PlayerData Data => Player?.PlayerData;
	ZombieSurvivalGame ZS => ZombieSurvivalGame.Current;

	string PhaseText => ZS?.Phase switch
	{
		ZombieSurvivalPhase.WaitingForPlayers => "Waiting",
		ZombieSurvivalPhase.Build => "Build",
		ZombieSurvivalPhase.Survival => "Survival",
		ZombieSurvivalPhase.RoundEnd => "Round End",
		_ => "Zombie Survival"
	};

	string TimerText
	{
		get
		{
			if ( ZS is null )
				return "--:--";

			if ( ZS.Phase == ZombieSurvivalPhase.WaitingForPlayers )
				return $"{ZS.HumanCount + ZS.ZombieCount}/{ZombieSurvivalGame.MinimumPlayersToStart}";

			return FormatTime( ZS.RemainingTime );
		}
	}

	string RoleText => Data?.ZombieSurvivalRole switch
	{
		ZombieSurvivalRole.Human => "Human",
		ZombieSurvivalRole.Zombie => ZombieSurvivalFormCatalog.Get( Data.ZombieSurvivalForm ).DisplayName,
		_ => "Joining"
	};

	string RoleClass => Data?.ZombieSurvivalRole switch
	{
		ZombieSurvivalRole.Human => "human",
		ZombieSurvivalRole.Zombie => "zombie",
		_ => "unassigned"
	};

	string ObjectiveText => ZS?.Phase switch
	{
		ZombieSurvivalPhase.WaitingForPlayers => "Waiting for enough players",
		ZombieSurvivalPhase.Build => "Place and fortify barricades",
		ZombieSurvivalPhase.Survival when Data?.ZombieSurvivalRole == ZombieSurvivalRole.Zombie => "Break barricades and infect humans",
		ZombieSurvivalPhase.Survival => "Hold out until time expires",
		ZombieSurvivalPhase.RoundEnd when ZS.HumansWonLastRound => "Humans survived",
		ZombieSurvivalPhase.RoundEnd => "Zombies overran the humans",
		_ => ""
	};

	protected override void OnUpdate()
	{
		SetClass( "build", ZS?.Phase == ZombieSurvivalPhase.Build );
		SetClass( "survival", ZS?.Phase == ZombieSurvivalPhase.Survival );
		SetClass( "round-end", ZS?.Phase == ZombieSurvivalPhase.RoundEnd );
		SetClass( "waiting", ZS?.Phase == ZombieSurvivalPhase.WaitingForPlayers );

		SetClass( "human", Data?.ZombieSurvivalRole == ZombieSurvivalRole.Human );
		SetClass( "zombie", Data?.ZombieSurvivalRole == ZombieSurvivalRole.Zombie );
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();

		hash.Add( ZombieSurvivalGame.Enabled );
		hash.Add( ZS?.Phase );
		hash.Add( (int)MathF.Ceiling( ZS?.RemainingTime ?? 0f ) );
		hash.Add( ZS?.HumansWonLastRound );
		hash.Add( ZS?.HumanCount );
		hash.Add( ZS?.ZombieCount );

		hash.Add( Data?.ZombieSurvivalRole );
		hash.Add( Data?.ZombieSurvivalForm );
		hash.Add( Data?.ZombieSurvivalRequestedForm );
		hash.Add( Data?.ZombieSurvivalBuildPoints );
		hash.Add( Data?.ZombieSurvivalCoins );

		hash.Add( ZombieSurvivalGame.GetPropSpawnCost() );
		hash.Add( Player?.WantsHideHud );

		return hash.ToHashCode();
	}

	private static string FormatTime( float seconds )
	{
		seconds = MathF.Max( seconds, 0f );

		var totalSeconds = (int)MathF.Ceiling( seconds );
		return $"{totalSeconds / 60:00}:{totalSeconds % 60:00}";
	}
}
