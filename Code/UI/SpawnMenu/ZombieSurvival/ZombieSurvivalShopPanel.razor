@using Sandbox
@using Sandbox.UI
@using System
@using System.Linq

@inherits Panel
@namespace Sandbox

<div class="zs-shop-panel">
	<div class="zs-shop-header">
		<div>
			<div class="zs-shop-title">@TitleText</div>
			<div class="zs-shop-subtitle">@SubtitleText</div>
		</div>

		<div class="zs-shop-wallet">
			<div class="zs-shop-wallet-label">Coins</div>
			<div class="zs-shop-wallet-value">@Coins</div>
		</div>
	</div>

	@if ( !CanUseShop )
	{
		<div class="zs-shop-blocked">
			<div class="zs-shop-blocked-title">@BlockedTitle</div>
			<div class="zs-shop-blocked-text">@BlockedText</div>
		</div>
	}
	else
	{
		<div class="zs-shop-grid">
			@foreach ( var item in Items )
			{
				var canBuy = CanBuy( item );

				<div class="@GetItemClass( item, canBuy )" @onclick="@(() => Buy( item ))">
					<div class="zs-shop-item-main">
						<div class="zs-shop-item-name">@item.DisplayName</div>
						<div class="zs-shop-item-description">@item.Description</div>
					</div>

					<div class="zs-shop-item-side">
						<div class="zs-shop-item-cost">@item.Cost</div>
						<div class="zs-shop-item-type">@item.Type</div>
					</div>
				</div>
			}
		</div>
	}
</div>

@code
{
	public string Category { get; set; }

	private Player LocalPlayer => Player.FindLocalPlayer();
	private PlayerData Data => LocalPlayer?.PlayerData;
	private ZombieSurvivalGame ZS => ZombieSurvivalGame.Current;

	private int Coins => Data?.ZombieSurvivalCoins ?? 0;

	private string TitleText => string.IsNullOrWhiteSpace( Category )
		? "Human Shop"
		: Category;

	private string SubtitleText
	{
		get
		{
			if ( ZS is null )
				return "Zombie Survival shop unavailable.";

			return ZS.Phase switch
			{
				ZombieSurvivalPhase.Build => "Buy weapons before the outbreak starts.",
				ZombieSurvivalPhase.Survival when ZombieSurvivalGame.AllowBuyDuringSurvival => "Buy quickly. The round is live.",
				ZombieSurvivalPhase.Survival => "Buying is disabled during survival.",
				ZombieSurvivalPhase.RoundEnd => "Shop closed until next round.",
				ZombieSurvivalPhase.WaitingForPlayers => "Waiting for players.",
				_ => ""
			};
		}
	}

	private string BlockedTitle
	{
		get
		{
			if ( Data?.ZombieSurvivalRole == ZombieSurvivalRole.Zombie )
				return "Zombies cannot buy";

			if ( ZS?.Phase == ZombieSurvivalPhase.WaitingForPlayers )
				return "Waiting for round";

			if ( ZS?.Phase == ZombieSurvivalPhase.RoundEnd )
				return "Round ended";

			return "Shop unavailable";
		}
	}

	private string BlockedText
	{
		get
		{
			if ( Data?.ZombieSurvivalRole == ZombieSurvivalRole.Zombie )
				return "The human shop is only available to humans.";

			if ( ZS?.Phase == ZombieSurvivalPhase.Survival && !ZombieSurvivalGame.AllowBuyDuringSurvival )
				return "Survival buying is disabled by server settings.";

			return "You cannot buy right now.";
		}
	}

	private bool CanUseShop
	{
		get
		{
			if ( !ZombieSurvivalGame.Enabled )
				return false;

			if ( LocalPlayer is null || !LocalPlayer.IsValid() )
				return false;

			if ( Data is null || !Data.IsValid() )
				return false;

			if ( Data.ZombieSurvivalRole != ZombieSurvivalRole.Human )
				return false;

			if ( ZS is null )
				return false;

			if ( ZS.Phase == ZombieSurvivalPhase.Build )
				return true;

			if ( ZS.Phase == ZombieSurvivalPhase.Survival && ZombieSurvivalGame.AllowBuyDuringSurvival )
				return true;

			return false;
		}
	}

	private ZombieSurvivalShopItem[] Items
	{
		get
		{
			if ( string.IsNullOrWhiteSpace( Category ) )
				return ZombieSurvivalShopCatalog.All.ToArray();

			return ZombieSurvivalShopCatalog.ByCategory( Category ).ToArray();
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();

		hash.Add( ZombieSurvivalGame.Enabled );
		hash.Add( Category );
		hash.Add( Coins );
		hash.Add( Data?.ZombieSurvivalRole );
		hash.Add( ZS?.Phase );
		hash.Add( ZombieSurvivalGame.AllowBuyDuringSurvival );

		foreach ( var item in Items )
		{
			hash.Add( item.Id );
			hash.Add( item.DisplayName );
			hash.Add( item.Description );
			hash.Add( item.Cost );
			hash.Add( item.Type );
			hash.Add( item.Category );
		}

		return hash.ToHashCode();
	}

	private bool CanBuy( ZombieSurvivalShopItem item )
	{
		if ( item is null )
			return false;

		if ( !CanUseShop )
			return false;

		if ( item.Type != ZombieSurvivalShopItemType.Weapon )
			return false;

		return Coins >= item.Cost;
	}

	private void Buy( ZombieSurvivalShopItem item )
	{
		if ( item is null )
			return;

		if ( !CanBuy( item ) )
			return;

		ZombieSurvivalGame.RequestBuyItem( item.Id );
	}

	private string GetItemClass( ZombieSurvivalShopItem item, bool canBuy )
	{
		var classes = "zs-shop-item";

		if ( item is null )
			return classes;

		classes += $" type-{item.Type.ToString().ToLowerInvariant()}";

		if ( canBuy )
			classes += " can-buy";
		else
			classes += " cannot-buy";

		if ( Coins < item.Cost )
			classes += " too-expensive";

		return classes;
	}
}
