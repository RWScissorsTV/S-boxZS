@using Sandbox
@using Sandbox.UI
@using System
@using System.Linq

@inherits Panel
@namespace Sandbox

<SpawnMenuContent>
	<Header>
		<SpawnMenuToolbar>
			<Left>
				<TextEntry Placeholder="Search..." class="filter menu-input" Value:bind=@Filter />
			</Left>

			<Right>
				<div class="zs-shop-coins">
					<span>Coins</span>
					<label>@Coins</label>
				</div>
			</Right>
		</SpawnMenuToolbar>
	</Header>

	<Body>
		@if ( !CanUseShop )
		{
			<div class="zs-shop-notice">
				<div>@BlockedTitle</div>
				<label>@BlockedText</label>
			</div>
		}

		<VirtualGrid Items=@FilteredItems ItemSize=@(120)>
			<Item Context="item">
				@if ( item is ZombieSurvivalShopItem shopItem )
				{
					var canBuy = CanBuy( shopItem );

					<div class="@GetShopIconClass( shopItem, canBuy )" @onclick="@(() => Buy( shopItem ))">
						<SpawnMenuIcon Ident=@GetSpawnMenuIdent( shopItem ) Title=@shopItem.DisplayName />

						<div class="zs-shop-price">@shopItem.Cost</div>
						<div class="zs-shop-name">@shopItem.DisplayName</div>
					</div>
				}
			</Item>
		</VirtualGrid>
	</Body>
</SpawnMenuContent>

@code
{
	public string Category { get; set; }

	private string _filter = "";

	private string Filter
	{
		get => _filter;
		set
		{
			_filter = value ?? "";
			StateHasChanged();
		}
	}

	private Player LocalPlayer => Player.FindLocalPlayer();
	private PlayerData Data => LocalPlayer?.PlayerData;
	private ZombieSurvivalGame ZS => ZombieSurvivalGame.Current;

	private int Coins => Data?.ZombieSurvivalCoins ?? 0;

	private ZombieSurvivalShopItem[] Items
	{
		get
		{
			if ( string.IsNullOrWhiteSpace( Category ) )
				return ZombieSurvivalShopCatalog.All.ToArray();

			return ZombieSurvivalShopCatalog.ByCategory( Category ).ToArray();
		}
	}

	private ZombieSurvivalShopItem[] FilteredItems
	{
		get
		{
			var items = Items;

			if ( string.IsNullOrWhiteSpace( Filter ) )
				return items;

			return items
				.Where( x =>
					x.DisplayName.Contains( Filter, StringComparison.OrdinalIgnoreCase )
					|| x.Description.Contains( Filter, StringComparison.OrdinalIgnoreCase )
					|| x.Category.Contains( Filter, StringComparison.OrdinalIgnoreCase )
					|| x.Id.Contains( Filter, StringComparison.OrdinalIgnoreCase )
					|| x.ResourcePath.Contains( Filter, StringComparison.OrdinalIgnoreCase )
				)
				.ToArray();
		}
	}

	private string BlockedTitle
	{
		get
		{
			if ( Data?.ZombieSurvivalRole == ZombieSurvivalRole.Zombie )
				return "Zombies Cannot Buy";

			if ( ZS?.Phase == ZombieSurvivalPhase.RoundEnd )
				return "Round Ended";

			return "Shop Unavailable";
		}
	}

	private string BlockedText
	{
		get
		{
			if ( Data?.ZombieSurvivalRole == ZombieSurvivalRole.Zombie )
				return "The human shop is only available to humans.";

			if ( ZS?.Phase == ZombieSurvivalPhase.Survival && !ZombieSurvivalGame.AllowBuyDuringSurvival )
				return "Survival buying is disabled by server settings.";

			return "You cannot buy right now.";
		}
	}

	private bool CanUseShop
	{
		get
		{
			if ( !ZombieSurvivalGame.Enabled )
				return false;

			if ( LocalPlayer is null || !LocalPlayer.IsValid() )
				return false;

			if ( Data is null || !Data.IsValid() )
				return false;

			if ( Data.ZombieSurvivalRole != ZombieSurvivalRole.Human )
				return false;

			if ( ZS is null )
				return false;

			if ( ZS.Phase == ZombieSurvivalPhase.WaitingForPlayers )
				return true;

			if ( ZS.Phase == ZombieSurvivalPhase.Build )
				return true;

			if ( ZS.Phase == ZombieSurvivalPhase.Survival && ZombieSurvivalGame.AllowBuyDuringSurvival )
				return true;

			return false;
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();

		hash.Add( ZombieSurvivalGame.Enabled );
		hash.Add( Category );
		hash.Add( Filter );
		hash.Add( Coins );
		hash.Add( Data?.ZombieSurvivalRole );
		hash.Add( ZS?.Phase );
		hash.Add( ZombieSurvivalGame.AllowBuyDuringSurvival );

		foreach ( var item in FilteredItems )
		{
			hash.Add( item.Id );
			hash.Add( item.DisplayName );
			hash.Add( item.Cost );
			hash.Add( item.Type );
			hash.Add( item.Category );
			hash.Add( item.ResourcePath );
			hash.Add( item.PreviewPath );
		}

		return hash.ToHashCode();
	}

	private bool CanBuy( ZombieSurvivalShopItem item )
	{
		if ( item is null )
			return false;

		if ( !CanUseShop )
			return false;

		if ( item.Type != ZombieSurvivalShopItemType.Weapon )
			return false;

		return Coins >= item.Cost;
	}

	private void Buy( ZombieSurvivalShopItem item )
	{
		if ( item is null )
			return;

		if ( !CanBuy( item ) )
			return;

		ZombieSurvivalGame.RequestBuyItem( item.Id );
	}

	private string GetShopIconClass( ZombieSurvivalShopItem item, bool canBuy )
	{
		var classes = "zs-shop-icon";

		if ( item is null )
			return classes;

		if ( canBuy )
			classes += " can-buy";
		else
			classes += " cannot-buy";

		if ( Coins < item.Cost )
			classes += " too-expensive";

		return classes;
	}

	private static string GetSpawnMenuIdent( ZombieSurvivalShopItem item )
	{
		if ( item is null )
			return "";

		var path = item.PreviewPath;

		if ( string.IsNullOrWhiteSpace( path ) )
			path = item.ResourcePath;

		path = path.Replace( "\\", "/" ).Trim();

		return $"prop:{path}";
	}
}
